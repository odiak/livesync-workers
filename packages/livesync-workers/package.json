{
  "name": "livesync-workers",
  "version": "0.11.0",
  "description": "Self-hosted LiveSync-compatible backend for Obsidian with search and MCP, for Cloudflare Workers",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/odiak/livesync-workers.git",
    "directory": "packages/livesync-workers"
  },
  "homepage": "https://github.com/odiak/livesync-workers#readme",
  "keywords": [
    "obsidian",
    "livesync",
    "couchdb",
    "cloudflare-workers",
    "durable-objects",
    "mcp"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "default": "./dist/mcp/index.js"
    },
    "./oauth": {
      "types": "./dist/oauth/index.d.ts",
      "default": "./dist/oauth/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "node scripts/prepack-readme.mjs"
  },
  "peerDependencies": {
    "@cloudflare/workers-oauth-provider": ">=1.2.4",
    "@modelcontextprotocol/sdk": ">=1.23.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@cloudflare/workers-oauth-provider": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@cloudflare/workers-types": "5.20261027.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
