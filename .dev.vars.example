# Secrets. Leave the values empty here; set real ones with `wrangler secret put NAME`
# (or in the Deploy to Cloudflare form, which lists these entries as required fields).
# The username is the LIVESYNC_USERNAME variable in wrangler.jsonc (default: obsidian).

# Password the Obsidian LiveSync plugin logs in with. Long and random is best.
LIVESYNC_PASSWORD=

# Password for the admin login (status page and authorizing MCP clients at /authorize).
ADMIN_PASSWORD=

# Random secret that signs admin session cookies and internal requests (32+ random chars).
SESSION_SECRET=

# Optional: a static bearer token for MCP clients that cannot do OAuth.
# It grants vault:read only; widen it with the MCP_STATIC_TOKEN_SCOPES variable.
# Kept commented out because every active entry in this file becomes a required
# field in the Deploy to Cloudflare form. Uncomment it for local dev, or add the
# secret with `wrangler secret put MCP_STATIC_TOKEN` / in the dashboard.
# MCP_STATIC_TOKEN=
